{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chocomania-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app.chocomania.in",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["30 20 * * *"]
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "test"
  },
  "env": {
    "test": {
      "name": "chocomania-test",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "app.chocomania.in",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "test"
      },
      "triggers": {
        "crons": ["30 20 * * *"]
      }
    },
    "live": {
      "name": "chocomania-live",
      "vars": {
        "APP_ENV": "live"
      },
      "triggers": {
        "crons": ["30 20 * * *"]
      }
    }
  }
}
