# Supabase connection (obtain from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only secrets (set via `wrangler secret put` in Cloudflare; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SESSION_CRYPTO_KEY=generate-a-random-64-hex-char-key-for-aes-gcm-cookie-encryption

# App configuration
APP_ENV=development
APP_ORIGIN=http://localhost:5173
OWNER_DEFAULT_PHONE=+919876543210
